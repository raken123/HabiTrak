# ---------------------------------------------------------------------------
# Hazelnut — local configuration
#
# Copy this file to `.env` and fill in your own key. `.env` is git-ignored.
# Never commit a real key: anything pushed to a repo (public or private) should
# be considered burned and rotated.
#
# Get a key: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------

# Required for every AI tool (Magic Draw, Realtouch, GIF Animate, AIScope Learn).
# Draw and Expand work without it, and Hazelnut Free never needs it.
HAZELNUT_GEMINI_API_KEY=

# Optional overrides.
HAZELNUT_IMAGE_MODEL=gemini-2.5-flash-image
HAZELNUT_TEXT_MODEL=gemini-2.5-flash

# Optional: point the client at a proxy or a regional endpoint.
# HAZELNUT_API_BASE=https://generativelanguage.googleapis.com/v1beta
