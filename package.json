{
  "name": "hazelnut-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Hazelnut \u2014 advanced AI photo generator for Windows and Mac, plus Hazelnut Squirreal for video, Hazelnut Mini and Hazelnut Free.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=hazelnut",
    "start:squirreal": "npm run start --workspace=hazelnut-squirreal",
    "start:movi": "npm run start --workspace=hazelnut-movi",
    "start:work": "npm run start --workspace=hazelnut-work",
    "start:mini": "npm run start --workspace=hazelnut-mini",
    "test": "node scripts/check-imports.mjs && node --test packages/core/test/*.test.js",
    "dist:hazelnut": "npm run dist --workspace=hazelnut",
    "dist:squirreal": "npm run dist --workspace=hazelnut-squirreal",
    "dist:mini": "npm run dist --workspace=hazelnut-mini",
    "check:imports": "node scripts/check-imports.mjs",
    "dist:aab": "./scripts/build-aab.sh",
    "mascot": "node scripts/build-mascot.mjs",
    "dist:movi": "npm run dist --workspace=hazelnut-movi",
    "dist:work": "npm run dist --workspace=hazelnut-work"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
